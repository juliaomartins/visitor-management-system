{
  "name": "@vms/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Generated TypeScript contracts for the VMS backend. Nothing hand-written lives in src/schema.d.ts.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts"
  },
  "files": [
    "src",
    "openapi.yaml"
  ],
  "scripts": {
    "generate": "bash ./scripts/generate.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.0",
    "typescript": "^5.9.0"
  }
}
