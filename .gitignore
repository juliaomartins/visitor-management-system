# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Django — .env holds real credentials; .env.example is the tracked template
.env
media/
staticfiles/
*.sqlite3
*.log

# Node
node_modules/
.next/
out/
dist/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Build artefacts that are large, regenerable, or both.
#
# Nothing here is source. Every one of these is produced by a command that is
# documented in CLAUDE.md, so a clone plus that command gets you back to the
# same place -- and none of it belongs in a repository somebody has to fetch
# over a conference wifi.

# PyInstaller (vms-desktop). `dist/` is ~113MB of bundled Qt; `build/` is its
# scratch. The .spec IS source and stays tracked.
build/
*.manifest

# Expo / React Native. A built .apk is 60MB+ and is rebuilt by EAS on demand.
.expo/
.expo-shared/
*.apk
*.aab
*.ipa
*.keystore
*.jks

# Next.js / tooling caches
.turbo/
*.tsbuildinfo
.eslintcache

# Python packaging and caches
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Git bundles, archives and database dumps -- backups belong outside the repo
*.bundle
*.zip
*.7z
*.tar
*.tar.gz
*.dump
*.sql

# Screenshots and scratch output from verification runs
/scratch/

# THE ORGANISERS' PRINTED CARD FILES. `ID CARD PVC SECOOP.pdf` is the 80-page
# production file the event's PVC cards were made from, and the badge geometry in
# `apps/badges/services.py` was measured out of it. It is NOT tracked, for two
# reasons: it is 55MB, and every page carries a real visitor's name, country and
# photograph -- exactly the passport-adjacent data this system is careful with
# everywhere else. Committing it would put 80 people into the history forever.
# Keep the file beside the repo; ask the organisers if you need it again.
ID CARD*.pdf

# draw.io writes a .$<name>.bkp autosave beside the file it is editing. It is a
# transient copy of the diagram, not a second diagram, and it changes on every
# keystroke -- committing it means a 55KB churn on every save.
.$*.bkp
